# ---------------------------------------------------------------------------
# Career Source Group — environment variables
# Copy to .env.local (local dev) or .env.production (production deploy) and
# fill in. Both .env.local and .env.production are gitignored.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required — contact/requirement/bench form storage) -----------
# Project URL and service-role key from the Supabase dashboard → Settings → API.
# Read server-side only, by src/lib/server/supabase-admin.ts. The service-role
# key BYPASSES row-level security — never expose it to the client, never
# import supabase-admin.ts from a component.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon key — not currently used server-side (all writes go through the
# service-role client) but kept for parity with the Supabase dashboard's
# standard env var set, and for any future client-side/read-only usage.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase personal access token — optional, only if your project/tools
# (e.g. the Supabase CLI) require it.
SUPABASE_ACCESS_TOKEN=

# --- Supabase schema ----------------------------------------------------
# Tables (client_requirements, candidate_applications, contact_submissions)
# and the private "resumes" Storage bucket must exist before forms will work.
# See supabase/migrations/*.sql — run each file in order via the Supabase
# SQL Editor (or `supabase db push` with the CLI) against a fresh project.

# --- Resend (staff notification email on each form submission) -------------
# Read server-side by src/lib/server/notify.ts. If any of the three vars
# below is unset, notification email is silently skipped — submissions still
# persist to Supabase either way. The Resend call is capped at a 5s timeout
# so a slow/unreachable Resend API can never stall a form submission.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@careersourcegroup.com
CONTACT_NOTIFICATION_EMAIL=hello@careersourcegroup.com

# --- Cloudflare Turnstile (bot protection on forms) --------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Calendly (booking, embedded iframe) -------------------------------------
NEXT_PUBLIC_CALENDLY_URL=

# --- Revalidation webhook (future CMS) ---------------------------------------
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Production-only — optional. The site and its forms work without these;
# only add them once the corresponding service is actually set up. Leave a
# value empty to keep the related feature (analytics, a social icon, a CRM/
# ATS sync) hidden/disabled.
# ---------------------------------------------------------------------------

# --- Analytics ----------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Google Analytics 4 property ID (starts with "G-").
NEXT_PUBLIC_GA4_ID=

# --- Social media profile URLs -----------------------------------------
# Leave empty to hide the corresponding icon in the footer.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- CRM sync (optional — mirrors employer leads to an external CRM) --------
CRM_ENDPOINT_URL=
CRM_API_KEY=

# --- ATS sync (optional — mirrors candidate profiles to an external ATS) ----
# Deferred for now — no ATS selected yet. Leave blank; candidate applications
# still save to Supabase regardless. Add these once an ATS is chosen.
ATS_ENDPOINT_URL=
ATS_API_KEY=

# --- Feature flags --------------------------------------------------------
NEXT_PUBLIC_ENABLE_SOCIAL_PROOF=true
NEXT_PUBLIC_ENABLE_CASE_STUDIES=true
