# ---------------------------------------------------------------------------
# Career Source Group — environment variables
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required — contact/requirement/bench form storage) -----------
# Project URL and service-role key from the Supabase dashboard → Settings → API.
# Read server-side only, by src/lib/server/supabase-admin.ts. The service-role
# key BYPASSES row-level security — never expose it to the client, never
# import supabase-admin.ts from a component.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon key — not currently used server-side (all writes go through the
# service-role client) but kept for parity with the Supabase dashboard's
# standard env var set, and for any future client-side/read-only usage.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase schema ----------------------------------------------------
# Tables (client_requirements, candidate_applications, contact_submissions)
# and the private "resumes" Storage bucket must exist before forms will work.
# See supabase/migrations/*.sql — run each file in order via the Supabase
# SQL Editor (or `supabase db push` with the CLI) against a fresh project.

# ---------------------------------------------------------------------------
# Everything below is present in some environments but NOT wired into the
# current form submission flow. Forms persist to Supabase only — no bot
# verification and no transactional email are sent yet.
# ---------------------------------------------------------------------------

# --- Resend (not wired — staff/candidate notification emails) ---------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@careersourcegroup.com
CONTACT_NOTIFICATION_EMAIL=hello@careersourcegroup.com

# --- Cloudflare Turnstile (not wired — bot protection) -----------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Calendly (booking, embedded iframe) -------------------------------------
NEXT_PUBLIC_CALENDLY_URL=

# --- Revalidation webhook (future CMS) ---------------------------------------
REVALIDATE_SECRET=

# --- Analytics (optional) ----------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED=false
